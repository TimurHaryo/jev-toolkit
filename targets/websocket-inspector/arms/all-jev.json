{
  "claudeMd": "stub",
  "rules": "jev",
  "hooks": {
    "PreToolUse": [
      { "matcher": "Edit|Write|MultiEdit", "bin": "jev-hook-comment-policy.mjs", "timeout": 10, "statusMessage": "JEV comment policy" },
      { "matcher": "Agent", "bin": "jev-hook-handback-pre.mjs", "timeout": 10 }
    ],
    "UserPromptSubmit": [
      { "bin": "jev-hook-dynamic-context.mjs", "timeout": 10, "statusMessage": "JEV selecting rules" }
    ],
    "PostToolUse": [
      { "matcher": "Agent", "bin": "jev-hook-handback-post.mjs", "timeout": 15, "statusMessage": "JEV hand-back check" }
    ]
  }
}
