{
  "claudeMd": "full",
  "rules": "jev",
  "hooks": {
    "PreToolUse": [
      { "matcher": "Agent", "bin": "jev-hook-handback-pre.mjs", "timeout": 10 }
    ],
    "PostToolUse": [
      { "matcher": "Agent", "bin": "jev-hook-handback-post.mjs", "timeout": 15, "statusMessage": "JEV hand-back check" }
    ]
  }
}
