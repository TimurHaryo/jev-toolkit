{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node /ABSOLUTE/PATH/TO/jev-toolkit/bin/jev-hook-comment-policy.mjs",
            "timeout": 10,
            "statusMessage": "JEV comment policy"
          }
        ]
      }
    ]
  }
}
